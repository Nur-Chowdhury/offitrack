// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  MAINTENANCE_STAFF
}

enum AssetCondition {
  NEW
  GOOD
  USED
  DAMAGED
  IN_REPAIR
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  IN_USE
  COMPLETED
  CANCELLED
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  name      String
  password  String
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt
  memberships OrganizationMembership[]
  assetAssignments AssetAssignment[]
  userBookings Booking[]
  reportedMaintenanceLogs MaintenanceLog[] @relation("ReportedBy")
  maintainedLogs MaintenanceLog[] @relation("MaintainedBy")
}

model Organization {
  id   String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members OrganizationMembership[]
  assets        Asset[]
  resources     Resource[]
  assetAssignments AssetAssignment[]
  bookings      Booking[]
  maintenanceLogs MaintenanceLog[]
  notifications Notification[]
}

model OrganizationMembership {
  role UserRole @default(EMPLOYEE)
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([userId, organizationId])
}

model Asset {
  id            String   @id @default(uuid())
  name          String
  type          String
  purchaseDate  DateTime
  condition     AssetCondition @default(GOOD)
  qrCode        String?   @unique
  depreciationData String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  maintenanceHistory MaintenanceLog[]
  assignments AssetAssignment[]
  @@index([organizationId])
}

model AssetAssignment {
  id        String   @id @default(uuid())
  assignedTime DateTime
  returnedAt DateTime? 
  notes     String?
  status    BookingStatus @default(PENDING)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId])
  @@index([assetId])
  @@index([userId])
}

model Resource {
  id          String   @id @default(uuid())
  name        String
  category    String
  quantity    Int      @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  bookings Booking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([organizationId])
}

model Booking {
  id        String        @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(PENDING)
  notes     String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId])
}

model MaintenanceLog {
  id                  String      @id @default(uuid())
  details             String
  cost                Float
  nextMaintenanceDate DateTime?
  isRepair            Boolean     @default(false)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  assetId             String
  asset               Asset   @relation(fields: [assetId], references: [id])
  reportedById        String?
  reportedBy          User?   @relation("ReportedBy", fields: [reportedById], references: [id])
  maintainedById      String?
  maintainedBy        User?   @relation("MaintainedBy", fields: [maintainedById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([organizationId])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  isRead    Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  recipientId String
  createdAt DateTime @default(now())
  relatedBookingId    String?
  relatedAssetId      String?
  relatedMaintenanceId String? 
  @@index([organizationId, recipientId])
}